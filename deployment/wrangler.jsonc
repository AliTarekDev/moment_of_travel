{
  "$schema": "../dist/deploy-tools/node_modules/wrangler/config-schema.json",
  "name": "ancientpaths",
  "account_id": "8e7323249b66da57226bb8d3426bb5ff",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "assets": {
    "directory": "../dist/cloudflare/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "API_ORIGIN": "https://ancientpaths-api-test-production.up.railway.app"
  }
}
