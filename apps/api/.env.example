NODE_ENV=development
API_PORT=3000
API_ORIGINS=http://localhost:4200,http://localhost:4201

DATABASE_URL=postgresql://dreamstour_app:Zox0123@localhost:5432/moment_of_travel


DB_SSL=false

DB_SYNCHRONIZE=true

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@ancientpaths.com
