# Tour image files; use a persistent directory in production.
CATALOG_UPLOAD_DIR=apps/api/uploads/catalog

# Server-side request notification emails. Enable after setting authentication.
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tali6184@gmail.com
BOOKING_NOTIFICATION_TO=info@ancientpathseg.com
SMTP_AUTH=password
# Gmail App Password, not the normal Google account password.
SMTP_PASSWORD=
# Optional Microsoft 365 alternative: set SMTP_HOST=smtp.office365.com,
# SMTP_USER to its mailbox, and SMTP_AUTH=oauth2 with these credentials:
